<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPT-VR-Preloader.dll - a BepInEx preloader patcher (BepInEx/patchers). It patches nothing: it writes the VR subsystem
       manifests into EscapeFromTarkov_Data/UnitySubsystems before Unity reads them, so VR starts on the first boot. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SPT-VR-Preloader</AssemblyName>
    <Description>Writes SPT-VR's XR plugin manifests before Unity reads them</Description>
    <Version>2.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TarkovVR.Preloader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Source\XR\VRDataFiles.cs" Link="VRDataFiles.cs" />
  </ItemGroup>

  <!-- BepInEx 5.4.23.5's own BepInEx.dll and Mono.Cecil 0.10.4 (copied from the game's BepInEx/core): the preloader resolves the
       Patch signature's AssemblyDefinition against the Cecil it ships -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\libs\BepInEx\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>..\libs\BepInEx\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
