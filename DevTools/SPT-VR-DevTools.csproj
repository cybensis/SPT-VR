<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tools for SPT-VR, NOT shipped to players: every [Tunable] knob, log and debug view of SPT-VR.dll as a BepInEx
       setting (in-game through Integrated Configuration Manager, on the desktop through ConfigurationManager), and the drawer for
       SPT-VR's DebugDraw shapes. Install: BepInEx/plugins/sptvr-devtools/SPT-VR-DevTools.dll next to the normal mod. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SPT-VR-DevTools</AssemblyName>
    <Description>SPT-VR developer tools: knobs, logs and debug views as settings, and the debug shape drawer</Description>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SptVrDevTools</RootNamespace>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only: the markers and DebugDraw live in SPT-VR.dll, which the game already loads -->
    <ProjectReference Include="..\TarkovVR.csproj" Private="false" />
  </ItemGroup>

</Project>
